#!/usr/bin/env python3
"""gelctl — remote control for the GEL execution engine.

Same command surface as the local ``gel`` CLI, but every invocation is
wrapped in ``ssh <host> 'gel <args>'``. Auth is whatever your normal
``~/.ssh/config`` says — typically a ``.pem`` key against an EC2 host
alias. No credentials live in this script.

Examples::

    gelctl status                                  # default host
    gelctl --host gel-prod accounts list
    gelctl --host gel-test daemon start
    gelctl connect                                 # interactive REPL over ssh
    gelctl python                                  # remote Python REPL

Defaults:
- Host alias: ``$GELCTL_HOST`` (env), or ``--host``, or ``gel-prod``.
- Remote ``gel`` path: ``$GELCTL_REMOTE_GEL`` (env), default ``gel``
  (must be on the remote user's PATH; see ``tools/aws/bootstrap.sh``).

Interactive commands (``connect``, ``python``, ``admin``) automatically
get ``ssh -t`` so the remote PTY is allocated; everything else streams
stdout normally.
"""
from __future__ import annotations

import os
import shlex
import subprocess
import sys
from pathlib import Path

DEFAULT_HOST       = os.environ.get("GELCTL_HOST",       "gel-prod")
REMOTE_GEL         = os.environ.get("GELCTL_REMOTE_GEL", "gel")
SSH_BIN            = os.environ.get("GELCTL_SSH",        "ssh")
SSH_EXTRA          = os.environ.get("GELCTL_SSH_OPTS",   "")  # extra flags
HISTFILE_PROXY     = Path.home() / ".gelctl_history"

# Commands that need a remote PTY. Anything that prompts the user, opens
# a REPL, or does a curses-style live UI on the server side.
INTERACTIVE_CMDS = {"connect", "python", "admin", "ipc"}  # ipc tap is interactive
INTERACTIVE_SUBS = {("ipc", "tap")}


def _is_interactive(argv: list[str]) -> bool:
    if not argv: return False
    if argv[0] in {"connect", "python", "admin"}: return True
    if len(argv) >= 2 and (argv[0], argv[1]) in INTERACTIVE_SUBS: return True
    return False


def _color(s: str, code: int) -> str:
    if not sys.stderr.isatty() or os.environ.get("NO_COLOR"):
        return s
    return f"\033[{code}m{s}\033[0m"


def _print_usage() -> int:
    print("gelctl — remote control for GEL", file=sys.stderr)
    print("", file=sys.stderr)
    print("usage:", file=sys.stderr)
    print("  gelctl [--host HOST] <gel-subcommand> [args...]", file=sys.stderr)
    print("                                # run gel command on the remote", file=sys.stderr)
    print("  gelctl install --ip IP --pem PATH [--host ALIAS] [--user USER]", file=sys.stderr)
    print("                                # first-time setup: writes ~/.ssh/config block", file=sys.stderr)
    print("  gelctl ipupdate IP [--host ALIAS]", file=sys.stderr)
    print("                                # change the static IP for an existing alias", file=sys.stderr)
    print("  gelctl uninstall [--host ALIAS]", file=sys.stderr)
    print("                                # remove the alias block from ~/.ssh/config", file=sys.stderr)
    print("  gelctl claude [--cwd DIR] [--name N] [--transient]", file=sys.stderr)
    print("                                # open Claude Code on the host", file=sys.stderr)
    print("                                #   default: tmux session 'claude' in ~/capstone", file=sys.stderr)
    print("                                #           (survives ssh disconnect)", file=sys.stderr)
    print("                                #   --transient = no tmux, dies on disconnect", file=sys.stderr)
    print("                                #   --cwd DIR   = start claude in DIR", file=sys.stderr)
    print("                                #   --name N    = parallel session under a different name", file=sys.stderr)
    print("  gelctl claude list            # show active tmux sessions on host", file=sys.stderr)
    print("  gelctl claude kill [--name N] # kill one session (default: 'claude')", file=sys.stderr)
    print("  gelctl claude clean           # kill ALL gelctl-managed sessions", file=sys.stderr)
    print("  gelctl claude logs            # tail ~/bootstrap.log", file=sys.stderr)
    print("  gelctl --check                # ssh dry-run + remote gel reachability", file=sys.stderr)
    print("  gelctl --hosts                # list gel-ish aliases in ~/.ssh/config", file=sys.stderr)
    print("  gelctl --help", file=sys.stderr)
    print("", file=sys.stderr)
    print(f"default host: {DEFAULT_HOST}  (override via --host or $GELCTL_HOST)", file=sys.stderr)
    print(f"remote gel  : {REMOTE_GEL}    (override via $GELCTL_REMOTE_GEL)", file=sys.stderr)
    return 0


def _check(host: str) -> int:
    """Verify ssh + remote gel reachability."""
    print(f"--> ssh {host} 'gel version'", file=sys.stderr)
    cmd = [SSH_BIN, *shlex.split(SSH_EXTRA), "-o", "BatchMode=yes",
           "-o", "ConnectTimeout=8", host, REMOTE_GEL, "version"]
    try:
        rc = subprocess.call(cmd)
    except FileNotFoundError:
        print(_color(f"error: {SSH_BIN} not found", 31), file=sys.stderr)
        return 127
    if rc == 0:
        print(_color("ok — gelctl is wired up correctly", 32), file=sys.stderr)
    else:
        print(_color(f"failed (rc={rc}). Things to check:", 31), file=sys.stderr)
        print("  1. ~/.ssh/config has a Host block named '" + host + "'", file=sys.stderr)
        print("  2. The .pem path in IdentityFile is readable (chmod 600)", file=sys.stderr)
        print("  3. Security Group permits SSH from your current IP", file=sys.stderr)
        print("  4. The remote user has 'gel' on PATH", file=sys.stderr)
        print("       (run tools/aws/bootstrap.sh on the server first)", file=sys.stderr)
    return rc


# ----------------------------------------------------------------------------
# ~/.ssh/config block manipulation
# ----------------------------------------------------------------------------
# We round-trip the config file as text rather than parsing the full SSH
# grammar — we only ever read/write the block we manage. The block is
# delimited by sentinel comments so we can rewrite it idempotently:
#
#     # >>> gelctl: <alias>
#     Host <alias>
#         HostName 1.2.3.4
#         User ec2-user
#         IdentityFile ~/.aws/gel.pem
#         StrictHostKeyChecking accept-new
#     # <<< gelctl: <alias>
#
# Lines outside the sentinels are left untouched. Multiple gelctl-managed
# aliases coexist fine.

SSH_CONFIG = Path.home() / ".ssh" / "config"


def _block_sentinels(alias: str) -> tuple[str, str]:
    return (f"# >>> gelctl: {alias}", f"# <<< gelctl: {alias}")


def _read_ssh_config() -> str:
    if SSH_CONFIG.exists():
        return SSH_CONFIG.read_text()
    return ""


def _write_ssh_config(text: str) -> None:
    SSH_CONFIG.parent.mkdir(parents=True, exist_ok=True)
    if not SSH_CONFIG.parent.stat().st_mode & 0o700 == 0o700:
        try:
            SSH_CONFIG.parent.chmod(0o700)
        except OSError:
            pass
    tmp = SSH_CONFIG.with_suffix(".tmp")
    tmp.write_text(text)
    tmp.chmod(0o600)
    tmp.replace(SSH_CONFIG)


def _splice_block(existing: str, alias: str, body: str | None) -> str:
    """Replace (or remove if body=None) the block for `alias` in `existing`."""
    begin, end = _block_sentinels(alias)
    lines = existing.splitlines()
    out: list[str] = []
    skip = False
    found = False
    for ln in lines:
        if ln.strip() == begin:
            skip = True
            found = True
            if body is not None:
                out.append(begin)
                for b in body.splitlines():
                    out.append(b)
                out.append(end)
            continue
        if skip:
            if ln.strip() == end:
                skip = False
            continue
        out.append(ln)

    if not found and body is not None:
        # Append a new block at the end.
        if out and out[-1].strip() != "":
            out.append("")
        out.append(begin)
        for b in body.splitlines():
            out.append(b)
        out.append(end)

    return "\n".join(out).rstrip("\n") + "\n"


def _block_body(alias: str, hostname: str, user: str, pem: str) -> str:
    return "\n".join([
        f"Host {alias}",
        f"    HostName {hostname}",
        f"    User {user}",
        f"    IdentityFile {pem}",
        f"    StrictHostKeyChecking accept-new",
        f"    ServerAliveInterval 30",
    ])


def _read_alias_field(alias: str, field: str) -> str | None:
    """Return the current value of <field> inside the gelctl-managed block."""
    begin, end = _block_sentinels(alias)
    lines = _read_ssh_config().splitlines()
    inside = False
    for ln in lines:
        s = ln.strip()
        if s == begin: inside = True; continue
        if s == end:   inside = False; continue
        if inside and s.lower().startswith(field.lower() + " "):
            return s.split(None, 1)[1].strip()
    return None


def _validate_pem(path: Path) -> str | None:
    if not path.exists():
        return f"pem file not found: {path}"
    mode = path.stat().st_mode & 0o777
    if mode & 0o077:
        return (f"pem file {path} has perms {oct(mode)}; ssh requires 600. "
                f"Run: chmod 600 {path}")
    return None


def cmd_install(argv: list[str]) -> int:
    ip = pem = None
    alias = DEFAULT_HOST
    user  = "ubuntu"   # AWS FPGA Developer AMI default
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--ip":     ip    = argv[i+1]; i += 2; continue
        if a == "--pem":    pem   = argv[i+1]; i += 2; continue
        if a == "--host":   alias = argv[i+1]; i += 2; continue
        if a == "--user":   user  = argv[i+1]; i += 2; continue
        print(f"unknown flag: {a}", file=sys.stderr)
        return 2
    if not ip or not pem:
        print("install needs --ip IP and --pem PATH", file=sys.stderr)
        return 2

    pem_path = Path(pem).expanduser().resolve()
    err = _validate_pem(pem_path)
    if err:
        print(_color("error: " + err, 31), file=sys.stderr)
        return 1

    body = _block_body(alias, ip, user, str(pem_path))
    new_text = _splice_block(_read_ssh_config(), alias, body)
    _write_ssh_config(new_text)
    print(_color(f"ok — wrote ~/.ssh/config block for '{alias}'", 32), file=sys.stderr)
    print(f"     HostName     = {ip}", file=sys.stderr)
    print(f"     User         = {user}", file=sys.stderr)
    print(f"     IdentityFile = {pem_path}", file=sys.stderr)
    print(f"", file=sys.stderr)
    print(_color(f"next: gelctl --host {alias} --check", 36), file=sys.stderr)
    return 0


def cmd_ipupdate(argv: list[str]) -> int:
    ip = None
    alias = DEFAULT_HOST
    i = 0
    pos: list[str] = []
    while i < len(argv):
        a = argv[i]
        if a == "--host": alias = argv[i+1]; i += 2; continue
        pos.append(a); i += 1
    if len(pos) != 1:
        print("usage: gelctl ipupdate <IP> [--host ALIAS]", file=sys.stderr)
        return 2
    ip = pos[0]

    cur_body = None
    begin, end = _block_sentinels(alias)
    inside = False
    block_lines: list[str] = []
    for ln in _read_ssh_config().splitlines():
        s = ln.strip()
        if s == begin: inside = True; continue
        if s == end:   inside = False; continue
        if inside: block_lines.append(ln)

    if not block_lines:
        print(_color(
            f"error: no gelctl block for '{alias}'. "
            f"Run `gelctl install --host {alias} --ip ... --pem ...` first.", 31),
            file=sys.stderr)
        return 1

    # Replace the HostName line in place; leave other fields untouched.
    old_ip = _read_alias_field(alias, "HostName") or "?"
    new_block: list[str] = []
    replaced = False
    for ln in block_lines:
        s = ln.lstrip()
        if s.lower().startswith("hostname "):
            indent = ln[: len(ln) - len(s)]
            new_block.append(f"{indent}HostName {ip}")
            replaced = True
        else:
            new_block.append(ln)
    if not replaced:
        new_block.insert(1, f"    HostName {ip}")

    new_text = _splice_block(_read_ssh_config(), alias, "\n".join(new_block))
    _write_ssh_config(new_text)
    print(_color(f"ok — '{alias}' HostName updated to {ip} (was {old_ip})", 32),
          file=sys.stderr)
    return 0


def cmd_uninstall(argv: list[str]) -> int:
    alias = DEFAULT_HOST
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--host": alias = argv[i+1]; i += 2; continue
        print(f"unknown flag: {a}", file=sys.stderr)
        return 2
    new_text = _splice_block(_read_ssh_config(), alias, None)
    if new_text == _read_ssh_config():
        print(f"(no gelctl block for '{alias}'; nothing to remove)", file=sys.stderr)
        return 0
    _write_ssh_config(new_text)
    print(_color(f"ok — removed '{alias}' block from ~/.ssh/config", 32), file=sys.stderr)
    return 0


# ----------------------------------------------------------------------------
# Claude Code on the remote host
# ----------------------------------------------------------------------------
# Two modes:
#   - persistent (default): the remote claude process runs inside a named
#     tmux session, so it survives if your laptop's ssh drops. Reattach
#     with the same `gelctl claude` command.
#   - transient (--transient): no tmux. claude lives only as long as your
#     ssh session. Dies on disconnect. Quick chats, no zombies.
#
# Cleanup:
#   gelctl claude list        list active sessions
#   gelctl claude kill        kill the default 'claude' session
#   gelctl claude kill --name X   kill a specific session
#   gelctl claude clean       kill ALL gelctl-managed sessions
#
# Multiple parallel sessions:
#   gelctl claude --name fpga --cwd ~/capstone/GEL/fpga
#   gelctl claude --name pcta --cwd ~/capstone/GEL/strategies/pcta

DEFAULT_CLAUDE_CWD     = "~/capstone"        # sees both GEL/ and connector/
DEFAULT_CLAUDE_SESSION = "claude"


def _flag_value(argv: list[str], flag: str, default: str) -> tuple[str, list[str]]:
    """Pop a `--flag VALUE` from argv. Returns (value, remaining_argv)."""
    if flag in argv:
        i = argv.index(flag)
        if i + 1 >= len(argv):
            print(f"{flag} needs a value", file=sys.stderr)
            sys.exit(2)
        return argv[i+1], argv[:i] + argv[i+2:]
    return default, argv


def _ssh_run(host: str, remote_cmd: str, *, tty: bool = False) -> int:
    cmd = [SSH_BIN, *shlex.split(SSH_EXTRA)]
    if tty: cmd += ["-t"]
    cmd += [host, remote_cmd]
    try:
        return subprocess.call(cmd)
    except KeyboardInterrupt:
        print("", file=sys.stderr)
        return 130


def _cmd_claude(argv: list[str], host: str) -> int:
    sub = argv[0] if argv else None

    # ---- subcommands that don't open Claude Code itself ----
    if sub == "logs":
        return _ssh_run(host, "tail -n 200 -f ~/bootstrap.log", tty=True)

    if sub == "list":
        return _ssh_run(host,
            "tmux list-sessions -F '#{session_name}\t#{session_created_string}\t#{session_attached}' "
            "2>/dev/null | awk -F'\\t' 'BEGIN{print \"NAME\\tCREATED\\tATTACHED\"}{print}' "
            "|| echo '(no tmux sessions)'")

    if sub == "kill":
        name, _ = _flag_value(argv[1:], "--name", DEFAULT_CLAUDE_SESSION)
        return _ssh_run(host,
            f"tmux kill-session -t {shlex.quote(name)} 2>/dev/null && echo 'killed: {name}' "
            f"|| echo 'no session named: {name}'")

    if sub == "clean":
        # Kill the default session and anything matching gelctl-* prefix.
        return _ssh_run(host, """
            killed=0
            for s in $(tmux list-sessions -F '#{session_name}' 2>/dev/null \
                       | grep -E '^(claude|gelctl-)'); do
                tmux kill-session -t "$s" && echo "killed: $s" && killed=$((killed+1))
            done
            [ "$killed" -eq 0 ] && echo "no gelctl-managed sessions to kill"
        """)

    # ---- default: open / reattach Claude Code ----
    cwd,       argv = _flag_value(argv, "--cwd",  DEFAULT_CLAUDE_CWD)
    name,      argv = _flag_value(argv, "--name", DEFAULT_CLAUDE_SESSION)
    transient = "--transient" in argv
    if transient: argv = [a for a in argv if a != "--transient"]

    if argv:
        print(f"unknown args: {' '.join(argv)}", file=sys.stderr)
        return 2

    install_check = (
        "command -v claude >/dev/null 2>&1 || "
        "{ echo 'claude not installed on host. Run install-claude.sh.' >&2; exit 127; }"
    )
    cd_cmd = f"cd {shlex.quote(cwd)} 2>/dev/null || cd ~"

    if transient:
        # Plain ssh -t. Internet drops → claude dies. Clean, no zombies.
        remote = f"{install_check}; {cd_cmd}; source ~/.aws-fpga-env 2>/dev/null; claude"
    else:
        # tmux new-session -A: attach if `name` exists, else create.
        # The session survives ssh disconnects.
        tmux_install = "command -v tmux >/dev/null 2>&1 || sudo apt-get install -yq tmux"
        inner = f"{cd_cmd}; source ~/.aws-fpga-env 2>/dev/null; claude"
        remote = (
            f"{install_check}; {tmux_install}; "
            f"tmux new-session -A -s {shlex.quote(name)} {shlex.quote(inner)}"
        )

    return _ssh_run(host, remote, tty=True)


def _list_hosts() -> int:
    cfg = Path.home() / ".ssh" / "config"
    if not cfg.exists():
        print("(no ~/.ssh/config)", file=sys.stderr)
        return 0
    aliases = []
    for line in cfg.read_text().splitlines():
        s = line.strip()
        if s.lower().startswith("host "):
            for h in s.split()[1:]:
                if "*" in h: continue
                if "gel" in h.lower() or "ec2" in h.lower() or "fpga" in h.lower():
                    aliases.append(h)
    if not aliases:
        print("(no gel-ish aliases in ~/.ssh/config — try `gelctl --check` after editing)",
              file=sys.stderr)
    else:
        for a in aliases:
            print(a)
    return 0


def main(argv: list[str]) -> int:
    host = DEFAULT_HOST
    rest: list[str] = []

    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--host":
            if i + 1 >= len(argv):
                print("--host needs an argument", file=sys.stderr)
                return 2
            host = argv[i + 1]
            i += 2
            continue
        if a in ("--help", "-h"):
            return _print_usage()
        if a == "--check":
            return _check(host)
        if a == "--hosts":
            return _list_hosts()
        rest.append(a)
        i += 1

    if not rest:
        return _print_usage()

    # Local-side helper subcommands — these manipulate ~/.ssh/config and
    # do NOT round-trip through ssh.
    if rest[0] == "install":
        return cmd_install(rest[1:] + (["--host", host] if "--host" not in rest[1:] else []))
    if rest[0] == "ipupdate":
        return cmd_ipupdate(rest[1:] + (["--host", host] if "--host" not in rest[1:] else []))
    if rest[0] == "uninstall":
        return cmd_uninstall(rest[1:] + (["--host", host] if "--host" not in rest[1:] else []))

    if rest[0] == "claude":
        return _cmd_claude(rest[1:], host)

    # Build the remote command. Quote each arg so the remote shell sees
    # exactly what we got — no glob expansion, no IFS surprises.
    remote_cmdline = " ".join(shlex.quote(p) for p in [REMOTE_GEL, *rest])

    cmd: list[str] = [SSH_BIN]
    if SSH_EXTRA: cmd += shlex.split(SSH_EXTRA)
    if _is_interactive(rest):
        cmd += ["-t"]   # allocate remote PTY for REPLs
    cmd += [host, remote_cmdline]

    try:
        return subprocess.call(cmd)
    except FileNotFoundError:
        print(_color(f"error: {SSH_BIN} not found", 31), file=sys.stderr)
        return 127
    except KeyboardInterrupt:
        print("", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
