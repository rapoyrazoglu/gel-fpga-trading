def cmd_ipc_create(args: argparse.Namespace) -> int:
    c = _ensure_connector_module()
    # Creating ShmServer truncates and zeros the header; bind it briefly
    # then drop the reference (the file persists).
    Path(args.orders).parent.mkdir(parents=True, exist_ok=True)
    Path(args.reports).parent.mkdir(parents=True, exist_ok=True)
    # connector module currently exposes ShmClient (attach), not ShmServer
    # (create) directly to Python — so we shell out to gel_daemon for the
    # creation step (it creates and then immediately drains).
    daemon = _find_binary("gel_daemon")
    if daemon is None:
        out.err("gel_daemon binary not found. Run: gel build --target connector_gel_daemon")
        return EXIT_NOT_FOUND
    # Spawn briefly to create the files, then SIGTERM.
    proc = subprocess.Popen([str(daemon), args.orders, args.reports],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    time.sleep(0.3)
    proc.send_signal(signal.SIGTERM)
    proc.wait()
    # If user wanted the daemon to keep running, they should use `gel daemon start`.
    out.ok(f"created {args.orders} and {args.reports}")
    return EXIT_OK


