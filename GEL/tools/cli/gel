def cmd_strategies_list(_args: argparse.Namespace) -> int:
    state = load_accounts()
    rows = []
    for s in state["strategies"]:
        builtin = "yes" if s["id"] in KNOWN_STRATEGY_IDS else "no"
        accts = sum(1 for x in state["assignments"] if x["strategy_id"] == s["id"])
        rows.append([s["id"], s["name"], builtin, accts])
    out.table(["id", "name", "built-in", "accts"], rows)
    return EXIT_OK


def cmd_strategies_add(args: argparse.Namespace) -> int:
    state = load_accounts()
    if any(s["id"] == args.id for s in state["strategies"]):
        out.err(f"strategy id {args.id} already exists")
        return EXIT_USAGE
    state["strategies"].append({"id": args.id, "name": args.name})
    save_accounts(state)
    out.ok(f"added strategy #{args.id} {args.name}")
    return EXIT_OK


def cmd_strategies_remove(args: argparse.Namespace) -> int:
    state = load_accounts()
    n = len(state["strategies"])
    state["strategies"] = [s for s in state["strategies"] if s["id"] != args.id]
    if len(state["strategies"]) == n:
        out.err(f"no strategy with id {args.id}")
        return EXIT_NOT_FOUND
    removed = [x for x in state["assignments"] if x["strategy_id"] == args.id]
    state["assignments"] = [x for x in state["assignments"] if x["strategy_id"] != args.id]
    save_accounts(state)
    out.ok(f"removed strategy #{args.id} (and {len(removed)} assignment(s))")
