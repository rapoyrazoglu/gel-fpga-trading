    out.info("")
    out.info(out.bold("=== symbols ==="))
    out.info(f"  symbols: {len(bundle['symbols']['symbols'])}")
    out.info("")
    out.info(out.bold("=== risk ==="))
    out.info(f"  configured strategies: {len(bundle['risk']['limits'])}")


