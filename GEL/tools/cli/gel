# JSON state I/O
# ============================================================================

def _load_json(path: Path, default: Any) -> Any:
    if not path.exists():
        return default
    try:
        return json.loads(path.read_text())
    except json.JSONDecodeError as e:
        out.err(f"corrupt JSON in {path}: {e}")
        sys.exit(EXIT_ERR)


def _save_json(path: Path, obj: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(obj, indent=2))
    tmp.replace(path)


def load_accounts() -> dict:
    return _load_json(ACCOUNTS_JSON, {
        "strategies":  [{"id": 1, "name": "PCTA"}, {"id": 2, "name": "MARKET_MAKER"}],
        "accounts":    [],
        "assignments": [],
    })


def save_accounts(state: dict) -> None:
    _save_json(ACCOUNTS_JSON, state)


def load_symbols() -> dict:
    return _load_json(SYMBOLS_JSON, {"symbols": []})


def save_symbols(state: dict) -> None:
    _save_json(SYMBOLS_JSON, state)


def load_risk() -> dict:
    return _load_json(RISK_JSON, {"limits": {}})


def save_risk(state: dict) -> None:
    _save_json(RISK_JSON, state)


