def cmd_doctor(_args: argparse.Namespace) -> int:
    checks: list[tuple[str, bool, str]] = []

    checks.append(("GEL repo root",  GEL_ROOT.exists(),       str(GEL_ROOT)))
    checks.append(("connector repo", CONNECTOR_ROOT.exists(), str(CONNECTOR_ROOT)))
    checks.append(("CMake available", shutil.which("cmake") is not None,
                   shutil.which("cmake") or ""))
    checks.append(("ssh available",   shutil.which("ssh")   is not None,
                   shutil.which("ssh")   or ""))

    for name in ["gel_integrated_demo", "connector_parity_test",
                 "connector_shm_roundtrip_test", "gel_daemon"]:
        b = _find_binary(name)
        checks.append((f"binary: {name}", b is not None, str(b) if b else "(not built)"))

    try:
        sys.path.insert(0, str(CONNECTOR_ROOT / "python"))
        import connector  # noqa: F401
        py_msg = "imported"
        py_ok  = True
    except ImportError as e:
        py_msg = f"FAIL: {e}"
        py_ok  = False
    checks.append(("python: connector", py_ok, py_msg))

    for label, path in [("config: accounts.json", ACCOUNTS_JSON),
                        ("config: symbols.json",  SYMBOLS_JSON),
                        ("config: risk.json",     RISK_JSON)]:
        checks.append((label, path.exists(), str(path)))

    err = _validate_accounts_state(load_accounts())
    checks.append(("accounts.json valid", err is None, err or "schema ok"))

    if out.json_mode:
        out.json([{"check": c, "ok": k, "detail": d} for c, k, d in checks])
        return EXIT_OK if all(k for _, k, _ in checks) else EXIT_ERR

    for label, ok_, detail in checks:
        marker = out.green("✓") if ok_ else out.red("✗")
        print(f" {marker}  {label:<28} {out.dim(detail)}")
    failed = [c for c, k, _ in checks if not k]
    print()
    if failed:
        print(out.red(f"{len(failed)} check(s) failed"))
        return EXIT_ERR
    print(out.green("all checks passed"))
    return EXIT_OK


