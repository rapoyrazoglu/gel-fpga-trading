def _ensure_connector_module() -> Any:
    """Import the connector Python module, building it on-demand if missing."""
    candidates = [
        CONNECTOR_ROOT / "python",
        BUILD_DIR / "connector_build",
    ]
    for c in candidates:
        if str(c) not in sys.path:
            sys.path.insert(0, str(c))
    try:
        import connector  # type: ignore
        return connector
    except ImportError:
        out.err("connector Python module not built. Run: gel build --target _connector_native")
        sys.exit(EXIT_NOT_FOUND)


def _find_binary(name: str, *, candidates: list[Path] | None = None) -> Path | None:
    """Locate a built binary, checking GEL build dir + connector build dir."""
    paths = candidates or [
        BUILD_DIR / name,
        BUILD_DIR / "connector_build" / name,
        CONNECTOR_ROOT / "build" / name,
        CONNECTOR_ROOT / "build" / "examples" / "cross_process" / name,
        BUILD_DIR / "connector_build" / "examples" / "cross_process" / name,
    ]
    for p in paths:
        if p.is_file() and os.access(p, os.X_OK):
            return p
    return None


def _strategy_name(state: dict, sid: int) -> str:
    for s in state["strategies"]:
        if s["id"] == sid:
            return s["name"]
    return f"#{sid}"


def _account_label(state: dict, aid: int) -> str:
    for a in state["accounts"]:
        if a["id"] == aid:
            return a["label"]
    return f"#{aid}"


def _validate_accounts_state(state: dict) -> str | None:
    """Return error message or None."""
    if not isinstance(state, dict):
        return "state must be a JSON object"
    for key in ("strategies", "accounts", "assignments"):
        if key not in state or not isinstance(state[key], list):
            return f"missing/non-list field: {key}"

    sids = {s["id"] for s in state["strategies"]}
    aids = {a["id"] for a in state["accounts"]}
    if 0 in aids:
        return "account id 0 is reserved (ACCOUNT_INVALID)"

    seen: set[tuple[int, int]] = set()
    for asn in state["assignments"]:
        sid, aid = asn["strategy_id"], asn["account_id"]
        if sid not in sids:
            return f"assignment references unknown strategy {sid}"
        if aid not in aids:
            return f"assignment references unknown account {aid}"
        if (sid, aid) in seen:
            return f"duplicate assignment ({sid},{aid})"
        seen.add((sid, aid))
    return None


