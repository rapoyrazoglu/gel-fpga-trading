def _run_binary(name: str, *extra: str) -> int:
    bin_path = _find_binary(name)
    if bin_path is None:
        out.err(f"{name} binary not built. Run: gel build --target {name}")
        return EXIT_NOT_FOUND
    out.info(f"$ {bin_path} {' '.join(extra)}".rstrip())
    return subprocess.call([str(bin_path), *extra])


