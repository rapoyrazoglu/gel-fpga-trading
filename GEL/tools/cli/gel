def cmd_assign_list(_args: argparse.Namespace) -> int:
    state = load_accounts()
    rows = []
    for x in state["assignments"]:
        rows.append([
            x["strategy_id"], _strategy_name(state, x["strategy_id"]),
            x["account_id"],  _account_label(state, x["account_id"]),
        ])
    out.table(["sid", "strategy", "aid", "account"], rows)
    return EXIT_OK


def cmd_assign_add(args: argparse.Namespace) -> int:
    state = load_accounts()
    if not any(s["id"] == args.strategy for s in state["strategies"]):
        out.err(f"unknown strategy id {args.strategy}")
        return EXIT_USAGE
    if not any(a["id"] == args.account for a in state["accounts"]):
        out.err(f"unknown account id {args.account}")
        return EXIT_USAGE
    if any(x["strategy_id"] == args.strategy and x["account_id"] == args.account
           for x in state["assignments"]):
        out.err("already assigned")
        return EXIT_USAGE
    state["assignments"].append({"strategy_id": args.strategy, "account_id": args.account})
    save_accounts(state)
    out.ok(f"assigned {_strategy_name(state, args.strategy)} → "
           f"{_account_label(state, args.account)}")
    return EXIT_OK


def cmd_assign_remove(args: argparse.Namespace) -> int:
    state = load_accounts()
    n = len(state["assignments"])
    state["assignments"] = [x for x in state["assignments"]
                            if not (x["strategy_id"] == args.strategy
                                    and x["account_id"] == args.account)]
    if len(state["assignments"]) == n:
        out.err("no such assignment")
        return EXIT_NOT_FOUND
    save_accounts(state)
    out.ok(f"unassigned strategy {args.strategy} from account {args.account}")
    return EXIT_OK


def cmd_assign_show(args: argparse.Namespace) -> int:
    state = load_accounts()
    if args.strategy is not None:
        accts = [x["account_id"] for x in state["assignments"]
                 if x["strategy_id"] == args.strategy]
        if out.json_mode:
            out.json({"strategy_id": args.strategy, "accounts": accts})
        else:
            label = _strategy_name(state, args.strategy)
            out.info(f"{label} (#{args.strategy}) → {len(accts)} account(s):")
            for aid in accts:
                out.info(f"  #{aid:<6} {_account_label(state, aid)}")
        return EXIT_OK
    if args.account is not None:
        sids = [x["strategy_id"] for x in state["assignments"]
                if x["account_id"] == args.account]
        if out.json_mode:
            out.json({"account_id": args.account, "strategies": sids})
        else:
            label = _account_label(state, args.account)
            out.info(f"{label} (#{args.account}) ← {len(sids)} strategy(ies):")
            for sid in sids:
                out.info(f"  #{sid:<6} {_strategy_name(state, sid)}")
        return EXIT_OK
    out.err("specify --strategy or --account")
    return EXIT_USAGE


