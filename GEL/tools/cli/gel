def cmd_ipc_tap(args: argparse.Namespace) -> int:
    c = _ensure_connector_module()
    try:
        client = c.ShmClient(args.orders, args.reports)
    except RuntimeError as e:
        out.err(str(e))
        return EXIT_NOT_FOUND
    out.info(f"tapping reports from {args.reports}  (ctrl-c to stop)")
    out.info(out.bold("ts_ns      coid    sid  status   side  qty       price            account"))
    try:
        while True:
            r = client.poll_report()
            if r is None:
                time.sleep(0.01)
                continue
            line = (f"{r.ts_ns:<10} {r.client_order_id:<7} "
                    f"{r.strategy_id:<4} {r.status:<8} {r.side:<5} "
                    f"{r.fill_quantity:<9} {r.fill_price_ticks:<16} "
                    f"#{r.account_id}")
            print(line)
            if out.json_mode is False and args.count:
                args.count -= 1
                if args.count <= 0: break
    except KeyboardInterrupt:
        out.info("")
        out.info("stopped.")
    return EXIT_OK


_SIDE_NAME_TO_ENUM = None  # lazy
_TYPE_NAME_TO_ENUM = None


def _side_enum(c: Any, name: str) -> Any:
    return {"BUY": c.Side.BUY, "SELL": c.Side.SELL}[name]


def _type_enum(c: Any, name: str) -> Any:
    table = {"MARKET":    c.OrdType.MARKET,
             "LIMIT":     c.OrdType.LIMIT,
             "IOC":       c.OrdType.IOC,
             "FOK":       c.OrdType.FOK,
             "POST_ONLY": c.OrdType.POST_ONLY}
    if hasattr(c.OrdType, "CANCEL"):
        table["CANCEL"]  = c.OrdType.CANCEL
        table["REPLACE"] = c.OrdType.REPLACE
    return table[name]


def _send_and_wait(client: Any, order: Any, wait: float) -> int:
    if not client.send_order(order):
        out.err("orders ring is full")
        return EXIT_ERR
    out.ok(f"sent coid={order.client_order_id} sid={order.strategy_id} "
           f"sym={order.symbol_id} type={order.ord_type} qty={order.quantity}")
    if wait <= 0:
        return EXIT_OK
    deadline = time.time() + wait
    while time.time() < deadline:
        r = client.poll_report()
        if r is not None and r.client_order_id == order.client_order_id:
            if out.json_mode:
                out.json({"status": r.status, "fill_qty": r.fill_quantity,
                          "fill_price_ticks": r.fill_price_ticks,
                          "account_id": r.account_id})
            else:
                out.info(f"  report: status={r.status} qty={r.fill_quantity} "
                         f"price_ticks={r.fill_price_ticks} acct=#{r.account_id}")
            return EXIT_OK
        time.sleep(0.005)
    out.warn(f"no report within {wait}s")
    return EXIT_OK


def cmd_ipc_send_order(args: argparse.Namespace) -> int:
    c = _ensure_connector_module()
    try:
        client = c.ShmClient(args.orders, args.reports)
    except RuntimeError as e:
        out.err(str(e))
        return EXIT_NOT_FOUND

    o = c.Order()
    o.ts_ns           = time.time_ns()
    o.client_order_id = args.coid if args.coid else int(time.time_ns() & 0xFFFFFFFF)
    o.strategy_id     = args.strategy
    o.symbol_id       = args.symbol
    o.account_id      = args.account
    o.quantity        = args.qty
    o.side            = int(_side_enum(c, args.side))
    o.ord_type        = int(_type_enum(c, args.type))
    o.tif             = int(c.TIF.DAY)
    o.price_ticks     = -1 if args.type == "MARKET" else c.to_ticks(args.price or 0.0)
    if hasattr(o, "ref_order_id") and args.ref_order_id is not None:
        o.ref_order_id = args.ref_order_id
    return _send_and_wait(client, o, args.wait)


