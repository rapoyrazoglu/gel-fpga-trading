def _cmake_configure_if_needed(debug: bool) -> int:
    if (BUILD_DIR / "CMakeCache.txt").exists():
        return EXIT_OK
    BUILD_DIR.mkdir(parents=True, exist_ok=True)
    btype = "Debug" if debug else "Release"
    out.info(f"configuring (CMake, {btype}) …")
    return subprocess.call(
        ["cmake", "-B", str(BUILD_DIR), "-S", str(GEL_ROOT),
         f"-DCMAKE_BUILD_TYPE={btype}"])


def cmd_build(args: argparse.Namespace) -> int:
    if args.action == "clean":
        if BUILD_DIR.exists():
            shutil.rmtree(BUILD_DIR)
            out.ok(f"removed {BUILD_DIR}")
        return EXIT_OK
    rc = _cmake_configure_if_needed(args.debug)
    if rc != 0: return rc
    cmd = ["cmake", "--build", str(BUILD_DIR), "-j"]
    if args.target:
        cmd += ["--target", args.target]
    out.info(" ".join(shlex.quote(c) for c in cmd))
    return subprocess.call(cmd)


