def cmd_connect(args: argparse.Namespace) -> int:
    """Enter the interactive REPL, optionally starting the daemon."""
    if not args.no_start_daemon and _daemon_pid() is None:
        if _find_binary("gel_daemon") is not None:
            rc = cmd_daemon_start(args)
            if rc != 0:
                out.warn("daemon failed to start; REPL will run without it")
        else:
            out.warn("gel_daemon binary not built; ipc commands will fail")
    GelRepl().cmdloop()
    return EXIT_OK


def cmd_disconnect(args: argparse.Namespace) -> int:
    """Stop the daemon (and exit the REPL if we're in one)."""
    return cmd_daemon_stop(args)


# ----------------------------------------------------------------------------
# REPL — interactive shell
# ----------------------------------------------------------------------------

# Top-level commands the REPL recognizes for tab completion. Must stay in
# sync with build_parser()'s subparsers.
REPL_COMMANDS = [
    "accounts", "strategies", "assign", "symbols", "risk", "config",
    "build", "demo", "parity", "shm-test", "ipc", "daemon",
    "admin", "python", "doctor", "backtest", "version",
    "status", "connect", "disconnect", "claude",
    "exit", "quit", "clear", "help",
]


class GelRepl(cmd.Cmd):
    intro = textwrap.dedent("""\
        gel — interactive session
        commands work without the 'gel' prefix:  accounts list / assign add ...
        type 'help' for the command tree, 'status' for daemon state,
             'exit' (or ctrl-d) to leave""")

    def __init__(self) -> None:
        super().__init__()
        self.parser = build_parser()
        self._update_prompt()

    # ---- prompt ----------------------------------------------------------
    def _update_prompt(self) -> None:
        pid = _daemon_pid()
        if pid:
            tag = f"gel(pid {pid})"
            self.prompt = (out.green(tag) + " > ") if out.use_color else tag + " > "
        else:
            tag = "gel(off)"
            self.prompt = (out.dim(tag) + " > ") if out.use_color else tag + " > "

    # ---- history ---------------------------------------------------------
    def preloop(self) -> None:
        if readline is not None and HISTORY_FILE.exists():
            try:
                readline.read_history_file(str(HISTORY_FILE))
            except OSError:
                pass

    def postloop(self) -> None:
        if readline is not None:
            readline.set_history_length(2000)
            try:
                readline.write_history_file(str(HISTORY_FILE))
            except OSError:
                pass

    # ---- cmd.Cmd plumbing -----------------------------------------------
    def emptyline(self) -> bool:
        return False  # don't repeat the last command

    def postcmd(self, stop: bool, _line: str) -> bool:
        self._update_prompt()
        return stop

    def completenames(self, text: str, *_ignored: Any) -> list[str]:
        return [c for c in REPL_COMMANDS if c.startswith(text)]

    # ---- dispatch --------------------------------------------------------
    def default(self, line: str) -> bool | None:
        line = line.strip()
        if not line or line.startswith("#"):
            return False

        # REPL-only built-ins first.
        if line in ("exit", "quit", r"\q", "q"):
            return True
        if line == "clear":
            os.system("clear" if os.name != "nt" else "cls")
            return False
        if line == "?":
            line = "help"

        # Otherwise re-parse as if the user had run it from the shell.
        try:
            argv = shlex.split(line)
        except ValueError as e:
            out.err(f"parse error: {e}")
            return False

        # Save global flag state — REPL commands may pass --json/--quiet but
        # those should affect *that* command only, not the whole session.
        saved = (out.json_mode, out.quiet, out.use_color)
        try:
            args = self.parser.parse_args(argv)
            if getattr(args, "json", False):     out.json_mode = True
            if getattr(args, "quiet", False):    out.quiet     = True
            if getattr(args, "no_color", False): out.use_color = False
            if hasattr(args, "func") and args.func:
                args.func(args)
        except SystemExit:
            # argparse calls sys.exit on --help and on bad args; suppress.
            pass
        except KeyboardInterrupt:
            out.info("")  # ctrl-c during a long-running command
        except Exception as e:
            out.err(f"{type(e).__name__}: {e}")
        finally:
            out.json_mode, out.quiet, out.use_color = saved
        return False

    # ---- explicit do_* for nicer help/completion -------------------------
    def do_help(self, arg: str) -> bool:
        if arg.strip():
            return self.default(f"{arg} --help") or False
        cmd_help_full(argparse.Namespace())
        out.info("")
        out.info(out.dim("REPL extras:"))
        out.info(out.dim("  status, connect, disconnect, clear, exit, quit, !<shell-cmd>"))
        return False

    def do_exit(self, _arg: str) -> bool: return True
    def do_quit(self, _arg: str) -> bool: return True

    def do_EOF(self, _arg: str) -> bool:  # ctrl-d
        print()
        return True

    def do_claude(self, arg: str) -> bool:
        """Spawn Claude Code as a subprocess. The gel REPL resumes when
        claude exits. This works the same whether you're running gel
        locally or via `gelctl connect` (which is ssh-wrapped) — claude
        is invoked on whichever machine the gel REPL is running on.
        Pass extra args after `claude`, e.g. `claude --resume`.
        """
        if not shutil.which("claude"):
            out.err("claude not on PATH. On this machine run: "
                    "tools/aws/install-claude.sh   (or `npm i -g @anthropic-ai/claude-code`)")
            return False
        cmd = ["claude"]
        if arg.strip():
            try:
                cmd += shlex.split(arg)
            except ValueError as e:
                out.err(f"parse error: {e}")
                return False
        out.info(out.dim("(launching claude — exit it to return here)"))
        try:
            subprocess.call(cmd)
        except KeyboardInterrupt:
            print()
        return False


