def _daemon_pid() -> int | None:
    if not DAEMON_PIDFILE.exists():
        return None
    try:
        pid = int(DAEMON_PIDFILE.read_text().strip())
    except ValueError:
        return None
    try:
        os.kill(pid, 0)
        return pid
    except ProcessLookupError:
        return None


def cmd_daemon_start(args: argparse.Namespace) -> int:
    if _daemon_pid():
        out.err(f"already running (pid {_daemon_pid()}). Use 'gel daemon stop' first.")
        return EXIT_USAGE
    daemon = _find_binary("gel_daemon")
    if daemon is None:
        out.err("gel_daemon binary not built. Run: gel build --target connector_gel_daemon")
        return EXIT_NOT_FOUND
    DAEMON_LOGFILE.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    DAEMON_PIDFILE.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    log = open(DAEMON_LOGFILE, "ab")
    proc = subprocess.Popen([str(daemon), args.orders, args.reports],
                            stdout=log, stderr=subprocess.STDOUT,
                            stdin=subprocess.DEVNULL,
                            start_new_session=True)
    DAEMON_PIDFILE.write_text(str(proc.pid))
    time.sleep(0.2)
    if proc.poll() is not None:
        DAEMON_PIDFILE.unlink(missing_ok=True)
        out.err(f"daemon exited immediately (rc={proc.returncode}). See {DAEMON_LOGFILE}")
        return EXIT_ERR
    out.ok(f"daemon started (pid {proc.pid})")
    out.info(f"  orders : {args.orders}")
    out.info(f"  reports: {args.reports}")
    out.info(f"  log    : {DAEMON_LOGFILE}")
    return EXIT_OK


def cmd_daemon_stop(_args: argparse.Namespace) -> int:
    pid = _daemon_pid()
    if pid is None:
        out.warn("no daemon running")
        DAEMON_PIDFILE.unlink(missing_ok=True)
        return EXIT_OK
    try:
        os.kill(pid, signal.SIGINT)
    except ProcessLookupError:
        pass
    for _ in range(50):
        time.sleep(0.05)
        if _daemon_pid() is None:
            DAEMON_PIDFILE.unlink(missing_ok=True)
            out.ok(f"stopped (pid {pid})")
            return EXIT_OK
    try:
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    DAEMON_PIDFILE.unlink(missing_ok=True)
    out.warn(f"forced kill (pid {pid})")
    return EXIT_OK


def cmd_daemon_status(_args: argparse.Namespace) -> int:
    pid = _daemon_pid()
    if pid is None:
        if out.json_mode:
            out.json({"running": False})
        else:
            out.info(out.dim("not running"))
        return EXIT_NOT_FOUND
    if out.json_mode:
        out.json({"running": True, "pid": pid,
                  "logfile": str(DAEMON_LOGFILE), "pidfile": str(DAEMON_PIDFILE)})
    else:
        out.info(out.green(f"running (pid {pid})"))
        out.info(f"  log    : {DAEMON_LOGFILE}")
        out.info(f"  pidfile: {DAEMON_PIDFILE}")
    return EXIT_OK


