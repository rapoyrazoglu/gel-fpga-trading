# ============================================================================
# Output helpers (color, tables, JSON mode)
# ============================================================================

class Out:
    """Wraps stdout. JSON mode silences human-readable output."""
    def __init__(self) -> None:
        self.json_mode = False
        self.quiet     = False
        self.use_color = sys.stdout.isatty() and not os.environ.get("NO_COLOR")

    def color(self, s: str, code: int) -> str:
        return f"\033[{code}m{s}\033[0m" if self.use_color else s

    def green (self, s: str) -> str: return self.color(s, 32)
    def red   (self, s: str) -> str: return self.color(s, 31)
    def yellow(self, s: str) -> str: return self.color(s, 33)
    def blue  (self, s: str) -> str: return self.color(s, 36)
    def dim   (self, s: str) -> str: return self.color(s, 2)
    def bold  (self, s: str) -> str: return self.color(s, 1)

    def info(self, msg: str) -> None:
        if not self.json_mode and not self.quiet:
            print(msg)

    def ok(self, msg: str) -> None:
        if not self.json_mode and not self.quiet:
            print(self.green("ok ") + msg)

    def warn(self, msg: str) -> None:
        if not self.json_mode:
            print(self.yellow("warn ") + msg, file=sys.stderr)

    def err(self, msg: str) -> None:
        if self.json_mode:
            print(json.dumps({"error": msg}))
        else:
            print(self.red("error ") + msg, file=sys.stderr)

    def json(self, obj: Any) -> None:
        print(json.dumps(obj, indent=2, default=str))

    def table(self, headers: list[str], rows: list[list[str]]) -> None:
        if self.json_mode:
            self.json([dict(zip(headers, r)) for r in rows])
            return
        if not rows:
            print(self.dim("(empty)"))
            return
        widths = [len(h) for h in headers]
        for row in rows:
            for i, cell in enumerate(row):
                widths[i] = max(widths[i], len(str(cell)))
        sep = "  "
        print(self.bold(sep.join(h.ljust(widths[i]) for i, h in enumerate(headers))))
        print(self.dim(sep.join("-" * w for w in widths)))
        for row in rows:
            print(sep.join(str(c).ljust(widths[i]) for i, c in enumerate(row)))


out = Out()


