DEFAULT_RISK = {
    "max_abs_position":    1_000_000,
    "max_order_qty":       100_000,
    "fat_finger_band_pct": 0.05,
    "max_orders_per_sec":  10_000,
}


def cmd_risk_show(args: argparse.Namespace) -> int:
    state = load_risk()
    if args.strategy is not None:
        limits = state["limits"].get(str(args.strategy), DEFAULT_RISK)
        if out.json_mode:
            out.json({"strategy_id": args.strategy, **limits})
        else:
            out.info(f"strategy #{args.strategy}:")
            for k, v in limits.items():
                out.info(f"  {k:<22} = {v}")
        return EXIT_OK
    rows = []
    for sid, lim in state["limits"].items():
        rows.append([sid, lim.get("max_abs_position"), lim.get("max_order_qty"),
                     lim.get("fat_finger_band_pct"), lim.get("max_orders_per_sec")])
    out.table(["sid", "max_pos", "max_order_qty", "fat_finger", "rate"], rows)
    return EXIT_OK


def cmd_risk_set(args: argparse.Namespace) -> int:
    state = load_risk()
    sid_key = str(args.strategy)
    cur = state["limits"].setdefault(sid_key, dict(DEFAULT_RISK))
    if args.max_position    is not None: cur["max_abs_position"]    = args.max_position
    if args.max_order_qty   is not None: cur["max_order_qty"]       = args.max_order_qty
    if args.fat_finger      is not None: cur["fat_finger_band_pct"] = args.fat_finger
    if args.rate            is not None: cur["max_orders_per_sec"]  = args.rate
    save_risk(state)
    out.ok(f"updated risk limits for strategy #{args.strategy}")
    if not out.json_mode:
        for k, v in cur.items():
            out.info(f"  {k:<22} = {v}")
    return EXIT_OK


