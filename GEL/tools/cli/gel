            ("config path",          "print resolved config paths"),
        ]),
        ("build", [
            ("build",                "configure if needed and build"),
            ("build --target T",     "build a single CMake target"),
            ("build clean",          "rm the build dir"),
        ]),
        ("run / verify", [
            ("demo",                 "run gel_integrated_demo"),
            ("parity",               "run connector_parity_test"),
            ("shm-test",             "run connector_shm_roundtrip_test"),
        ]),
        ("ipc (cross-process)", [
            ("ipc create",           "create the SHM ring files"),
            ("ipc status",           "show pending counts"),
            ("ipc tap",              "live-tail incoming ExecReports"),
            ("ipc send-order",       "send a single order via SHM"),
            ("ipc cancel",           "send a CANCEL for an open order"),
            ("ipc replace",          "send a REPLACE for an open order"),
        ]),
        ("daemon", [
            ("daemon start",         "spawn gel_daemon in the background"),
            ("daemon stop",          "send SIGINT, then SIGKILL after 2.5s"),
            ("daemon status",        "running? pid? logfile?"),
        ]),
        ("session (REPL)", [
            ("connect",              "enter interactive REPL (auto-starts daemon)"),
            ("connect --no-start-daemon", "REPL without auto-starting the daemon"),
            ("disconnect",           "stop the daemon"),
            ("status",               "daemon + config + binaries summary"),
            ("claude",               "spawn Claude Code from the REPL (returns on exit)"),
        ]),
        ("tools", [
            ("admin",                "open the account-admin web UI"),
            ("python",               "Python REPL with `connector` imported"),
            ("doctor",               "environment health check"),
            ("backtest",             "(stub — not implemented yet)"),
            ("version",              "version info"),
            ("help",                 "this listing"),
        ]),
    ]
    for section_name, cmds in sections:
        print(out.bold(f"  {section_name}"))
        for c, desc in cmds:
            print(f"    {out.green('gel ' + c):<40} {out.dim(desc)}")
        print()
    print(out.dim("global flags: --json   --quiet   --no-color"))
    print(out.dim("any command:  gel <cmd> --help    for full flag list"))
    return EXIT_OK


# ============================================================================
# Argument parser
# ============================================================================

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="gel",
        description="GEL execution engine CLI",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("--json",   action="store_true", help="machine-readable JSON output")
    p.add_argument("--quiet",  action="store_true", help="suppress non-essential output")
    p.add_argument("--no-color", action="store_true", help="disable ANSI colors")
    sub = p.add_subparsers(dest="cmd", required=False)

    def add(name: str, **kw) -> argparse.ArgumentParser:
        return sub.add_parser(name, **kw)

    def nest(parent: argparse.ArgumentParser) -> Any:
        return parent.add_subparsers(dest="sub", required=True)

    # ---- accounts ----
    accounts = nest(add("accounts", help="manage broker accounts"))
    accounts.add_parser("list", help="list accounts").set_defaults(func=cmd_accounts_list)
    a_add = accounts.add_parser("add", help="register a new account")
    a_add.add_argument("--id",      type=int, required=True)
    a_add.add_argument("--label",   required=True)
    a_add.add_argument("--venue",   default="OANDA")
    a_add.add_argument("--capital", type=int, default=100_000, help="capital units")
    a_add.add_argument("--live",    action="store_true", help="real money (default: paper)")
    a_add.set_defaults(func=cmd_accounts_add)
    a_rm = accounts.add_parser("remove", help="remove an account by id")
    a_rm.add_argument("--id", type=int, required=True)
    a_rm.set_defaults(func=cmd_accounts_remove)
    a_sh = accounts.add_parser("show", help="show full detail for one account")
    a_sh.add_argument("--id", type=int, required=True)
    a_sh.set_defaults(func=cmd_accounts_show)

    # ---- strategies ----
    strategies = nest(add("strategies", help="manage strategy registry"))
    strategies.add_parser("list").set_defaults(func=cmd_strategies_list)
    s_add = strategies.add_parser("add")
    s_add.add_argument("--id",   type=int, required=True)
    s_add.add_argument("--name", required=True)
    s_add.set_defaults(func=cmd_strategies_add)
    s_rm = strategies.add_parser("remove")
    s_rm.add_argument("--id", type=int, required=True)
    s_rm.set_defaults(func=cmd_strategies_remove)

    # ---- assign ----
    assign = nest(add("assign", help="strategy ↔ account assignments"))
    assign.add_parser("list").set_defaults(func=cmd_assign_list)
    asn_a = assign.add_parser("add", help="link a strategy to an account")
    asn_a.add_argument("--strategy", type=int, required=True)
    asn_a.add_argument("--account",  type=int, required=True)
    asn_a.set_defaults(func=cmd_assign_add)
    asn_r = assign.add_parser("remove", help="unlink")
    asn_r.add_argument("--strategy", type=int, required=True)
    asn_r.add_argument("--account",  type=int, required=True)
    asn_r.set_defaults(func=cmd_assign_remove)
    asn_s = assign.add_parser("show", help="show links for one side")
    asn_s.add_argument("--strategy", type=int)
    asn_s.add_argument("--account",  type=int)
    asn_s.set_defaults(func=cmd_assign_show)

    # ---- symbols ----
    symbols = nest(add("symbols", help="manage symbol registry"))
    symbols.add_parser("list").set_defaults(func=cmd_symbols_list)
    sy_add = symbols.add_parser("add")
    sy_add.add_argument("--ticker",     required=True)
    sy_add.add_argument("--venue",      default="OANDA")
    sy_add.add_argument("--tick-size",  type=int, default=1)
    sy_add.add_argument("--lot",        type=int, default=1)
    sy_add.set_defaults(func=cmd_symbols_add)
    sy_rm = symbols.add_parser("remove")
    sy_rm.add_argument("--ticker", required=True)
    sy_rm.set_defaults(func=cmd_symbols_remove)

    # ---- risk ----
    risk = nest(add("risk", help="risk limits per strategy"))
    rk_sh = risk.add_parser("show")
    rk_sh.add_argument("--strategy", type=int)
    rk_sh.set_defaults(func=cmd_risk_show)
    rk_st = risk.add_parser("set")
    rk_st.add_argument("--strategy",       type=int, required=True)
    rk_st.add_argument("--max-position",   type=int)
    rk_st.add_argument("--max-order-qty",  type=int)
    rk_st.add_argument("--fat-finger",     type=float, dest="fat_finger")
    rk_st.add_argument("--rate",           type=int)
    rk_st.set_defaults(func=cmd_risk_set)

    # ---- config ----
    config = nest(add("config", help="config files"))
    config.add_parser("show",     help="print bundled config").set_defaults(func=cmd_config_show)
    config.add_parser("validate", help="schema check").set_defaults(func=cmd_config_validate)
    config.add_parser("edit",     help="open admin web UI").set_defaults(func=cmd_config_edit)
    config.add_parser("path",     help="print config paths").set_defaults(func=cmd_config_path)

    # ---- build ----
    bld = add("build", help="build GEL + connector targets")
    bld.add_argument("action", nargs="?", choices=["clean"])
    bld.add_argument("--target")
    bld.add_argument("--debug",  action="store_true")
    bld.set_defaults(func=cmd_build)

    # ---- run / verify ----
    add("demo",     help="run gel_integrated_demo").set_defaults(func=cmd_demo)
    add("parity",   help="run connector_parity_test").set_defaults(func=cmd_parity)
    add("shm-test", help="run connector_shm_roundtrip_test").set_defaults(func=cmd_shm_test)

    # ---- ipc ----
    ipc = nest(add("ipc", help="cross-process IPC ops (SHM)"))
    ipc_c = ipc.add_parser("create", help="create the SHM ring files")
    ipc_c.add_argument("--orders",  default=DEFAULT_ORDERS_SHM)
    ipc_c.add_argument("--reports", default=DEFAULT_REPORTS_SHM)
    ipc_c.set_defaults(func=cmd_ipc_create)
    ipc_s = ipc.add_parser("status", help="show pending counts")
    ipc_s.add_argument("--orders",  default=DEFAULT_ORDERS_SHM)
    ipc_s.add_argument("--reports", default=DEFAULT_REPORTS_SHM)
    ipc_s.set_defaults(func=cmd_ipc_status)
    ipc_t = ipc.add_parser("tap", help="live-tail incoming ExecReports")
    ipc_t.add_argument("--orders",  default=DEFAULT_ORDERS_SHM)
    ipc_t.add_argument("--reports", default=DEFAULT_REPORTS_SHM)
    ipc_t.add_argument("--count", type=int, help="exit after N reports")
    ipc_t.set_defaults(func=cmd_ipc_tap)
    ipc_so = ipc.add_parser("send-order", help="send a single order via SHM")
    ipc_so.add_argument("--strategy", type=int, required=True)
    ipc_so.add_argument("--symbol",   type=int, required=True)
    ipc_so.add_argument("--side",     choices=["BUY", "SELL"], required=True)
    ipc_so.add_argument("--qty",      type=int, required=True)
    ipc_so.add_argument("--price",    type=float)
    ipc_so.add_argument("--type",     choices=["MARKET", "LIMIT", "IOC", "FOK", "POST_ONLY",
                                               "CANCEL", "REPLACE"], default="MARKET")
    ipc_so.add_argument("--account",       type=int, default=0)
    ipc_so.add_argument("--coid",          type=int, help="client order id (default: time-derived)")
    ipc_so.add_argument("--ref-order-id",  type=int, dest="ref_order_id",
                        help="for CANCEL/REPLACE: original coid to operate on")
    ipc_so.add_argument("--orders",   default=DEFAULT_ORDERS_SHM)
    ipc_so.add_argument("--reports",  default=DEFAULT_REPORTS_SHM)
    ipc_so.add_argument("--wait",     type=float, default=2.0,
                        help="wait N seconds for report (0 = don't wait)")
    ipc_so.set_defaults(func=cmd_ipc_send_order)

    ipc_can = ipc.add_parser("cancel", help="send a CANCEL for an open order")
    ipc_can.add_argument("--strategy", type=int, required=True)
    ipc_can.add_argument("--coid",     type=int, required=True,
                         help="client order id of the order to cancel")
    ipc_can.add_argument("--symbol",   type=int, default=0)
    ipc_can.add_argument("--account",  type=int, default=0)
    ipc_can.add_argument("--orders",   default=DEFAULT_ORDERS_SHM)
    ipc_can.add_argument("--reports",  default=DEFAULT_REPORTS_SHM)
    ipc_can.add_argument("--wait",     type=float, default=2.0)
    ipc_can.set_defaults(func=cmd_ipc_cancel)

    ipc_rep = ipc.add_parser("replace", help="send a REPLACE for an open order")
    ipc_rep.add_argument("--strategy", type=int, required=True)
    ipc_rep.add_argument("--coid",     type=int, required=True,
                         help="original client order id to replace")
    ipc_rep.add_argument("--new-coid", type=int, dest="new_coid",
                         help="fresh coid for the replacement (default: time-derived)")
    ipc_rep.add_argument("--symbol",   type=int, required=True)
    ipc_rep.add_argument("--side",     choices=["BUY", "SELL"], required=True)
    ipc_rep.add_argument("--qty",      type=int, required=True)
    ipc_rep.add_argument("--price",    type=float, required=True)
    ipc_rep.add_argument("--account",  type=int, default=0)
    ipc_rep.add_argument("--orders",   default=DEFAULT_ORDERS_SHM)
    ipc_rep.add_argument("--reports",  default=DEFAULT_REPORTS_SHM)
    ipc_rep.add_argument("--wait",     type=float, default=2.0)
    ipc_rep.set_defaults(func=cmd_ipc_replace)

    # ---- daemon ----
    daemon = nest(add("daemon", help="manage the local fill-echo daemon"))
    dst = daemon.add_parser("start", help="spawn gel_daemon in the background")
    dst.add_argument("--orders",  default=DEFAULT_ORDERS_SHM)
    dst.add_argument("--reports", default=DEFAULT_REPORTS_SHM)
    dst.set_defaults(func=cmd_daemon_start)
    daemon.add_parser("stop",   help="signal SIGINT, then SIGKILL after 2.5s") \
          .set_defaults(func=cmd_daemon_stop)
    daemon.add_parser("status", help="show running pid + log").set_defaults(func=cmd_daemon_status)

    # ---- tools ----
    add("admin",     help="open the account-admin web UI").set_defaults(func=cmd_admin)
    add("python",    help="Python REPL with connector loaded").set_defaults(func=cmd_python)
    add("doctor",    help="environment health check").set_defaults(func=cmd_doctor)
    add("backtest",  help="historical replay (stub)").set_defaults(func=cmd_backtest_stub)
    add("version",   help="version + git rev").set_defaults(func=cmd_version)
    add("help",      help="show full command tree").set_defaults(func=cmd_help_full)

    # ---- REPL family ----
    add("status",     help="quick system status (daemon + config + binaries)").set_defaults(func=cmd_status)
    con = add("connect", help="enter the interactive REPL")
    con.add_argument("--no-start-daemon", action="store_true",
                     help="don't auto-start the daemon when opening the REPL")
    con.add_argument("--orders",  default=DEFAULT_ORDERS_SHM)
    con.add_argument("--reports", default=DEFAULT_REPORTS_SHM)
    con.set_defaults(func=cmd_connect)
    add("disconnect", help="stop the daemon").set_defaults(func=cmd_disconnect)

    return p


# ============================================================================
# Entry point
# ============================================================================

def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.json:     out.json_mode = True
    if args.quiet:    out.quiet     = True
    if args.no_color: out.use_color = False

    if not getattr(args, "func", None):
        # Default to help when no subcommand was given.
        return cmd_help_full(args)
    try:
        return args.func(args)
    except KeyboardInterrupt:
        out.info("")
        return 130


if __name__ == "__main__":
    sys.exit(main())
