def cmd_accounts_list(_args: argparse.Namespace) -> int:
    state = load_accounts()
    rows = []
    for a in state["accounts"]:
        rows.append([
            a["id"],
            a["label"],
            a.get("venue", ""),
            a.get("capital_units", 0),
            "LIVE" if a.get("live") else "paper",
            sum(1 for x in state["assignments"] if x["account_id"] == a["id"]),
        ])
    out.table(["id", "label", "venue", "capital", "mode", "strats"], rows)
    return EXIT_OK


def cmd_accounts_add(args: argparse.Namespace) -> int:
    state = load_accounts()
    if args.id == 0:
        out.err("id 0 is reserved (ACCOUNT_INVALID)")
        return EXIT_USAGE
    if any(a["id"] == args.id for a in state["accounts"]):
        out.err(f"account id {args.id} already exists")
        return EXIT_USAGE
    state["accounts"].append({
        "id":            args.id,
        "label":         args.label,
        "venue":         args.venue,
        "capital_units": args.capital,
        "live":          args.live,
    })
    save_accounts(state)
    out.ok(f"added account #{args.id} {args.label} ({args.venue}, "
           f"{'LIVE' if args.live else 'paper'})")
    return EXIT_OK


def cmd_accounts_remove(args: argparse.Namespace) -> int:
    state = load_accounts()
    n = len(state["accounts"])
    state["accounts"] = [a for a in state["accounts"] if a["id"] != args.id]
    if len(state["accounts"]) == n:
        out.err(f"no account with id {args.id}")
        return EXIT_NOT_FOUND
    removed_assignments = [x for x in state["assignments"] if x["account_id"] == args.id]
    state["assignments"] = [x for x in state["assignments"] if x["account_id"] != args.id]
    save_accounts(state)
    out.ok(f"removed account #{args.id} (and {len(removed_assignments)} assignment(s))")
    return EXIT_OK


def cmd_accounts_show(args: argparse.Namespace) -> int:
    state = load_accounts()
    for a in state["accounts"]:
        if a["id"] == args.id:
            strats = [_strategy_name(state, x["strategy_id"])
                      for x in state["assignments"] if x["account_id"] == args.id]
            if out.json_mode:
                out.json({**a, "strategies": strats})
            else:
                out.info(f"id:        {a['id']}")
                out.info(f"label:     {a['label']}")
                out.info(f"venue:     {a.get('venue', '')}")
                out.info(f"capital:   {a.get('capital_units', 0)}")
                out.info(f"live:      {a.get('live', False)}")
                out.info(f"strategies: {', '.join(strats) if strats else '(none)'}")
            return EXIT_OK
    out.err(f"no account with id {args.id}")
    return EXIT_NOT_FOUND


